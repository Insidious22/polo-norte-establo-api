APP_NAME="Polo Norte - Establo API (Escenario B)"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Base de datos MySQL (ajusta tus credenciales locales; nunca subas .env a Git)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=polo_norte_establo
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ==============================================================================
# Seguridad por Roles (API Keys en Header Authorization: Bearer <TOKEN>)
# Reemplaza estos valores de ejemplo en tu archivo .env local
# ==============================================================================
API_TOKEN_JEFE_ESTABLO=CAMBIA_ESTE_TOKEN_JEFE_ESTABLO
API_TOKEN_AYUDANTE=CAMBIA_ESTE_TOKEN_AYUDANTE

# ==============================================================================
# Integración SOAP: MeteoPoloNorteService
# Si el docente proporciona un endpoint externo, solo actualiza SOAP_METEO_URL
# ==============================================================================
SOAP_METEO_URL=http://127.0.0.1:4001/meteo
SOAP_TIMEOUT_SECONDS=3
SOAP_MAX_ATTEMPTS=2
SOAP_BACKOFF_MS=300
