{
  "info": {
    "name": "Parcial 1 · Escenario B · Establo de Renos y Mantenimiento (Santiago Castro)",
    "description": "Colección de pruebas completa para el Escenario B (Establo de renos y mantenimiento del terreno).\n\nAntes de ejecutar:\n1. Levanta MySQL y corre: php artisan migrate:fresh --seed\n2. Levanta el Mock SOAP: php -S 127.0.0.1:4001 mock-soap/server.php\n3. Levanta la API Laravel: php artisan serve\n4. Ajusta las variables de colección token_jefe y token_ayudante para que coincidan con tu .env local.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "token_jefe", "value": "PON_AQUI_TU_API_TOKEN_JEFE_ESTABLO" },
    { "key": "token_ayudante", "value": "PON_AQUI_TU_API_TOKEN_AYUDANTE" },
    { "key": "reno_creado_id", "value": "11" },
    { "key": "reno_decimo_id", "value": "12" },
    { "key": "mantenimiento_pista_id", "value": "1" }
  ],
  "item": [
    {
      "name": "1. Seguridad (401 y 403)",
      "item": [
        {
          "name": "401 · Crear reno SIN token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Responde 401 Unauthorized', () => pm.response.to.have.status(401));",
                  "const j = pm.response.json();",
                  "pm.test('Formato estándar de error', () => {",
                  "  pm.expect(j).to.have.all.keys('codigo', 'mensaje', 'detalles', 'timestamp', 'ruta');",
                  "  pm.expect(j.codigo).to.eql('NO_AUTENTICADO');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Rodolfo\",\n  \"edad\": 5,\n  \"nivelEnergia\": 98\n}"
            },
            "url": "{{base_url}}/api/renos"
          }
        },
        {
          "name": "403 · Crear reno con rol AYUDANTE (rol insuficiente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Responde 403 Forbidden', () => pm.response.to.have.status(403));",
                  "const j = pm.response.json();",
                  "pm.test('Código ROL_INSUFICIENTE', () => pm.expect(j.codigo).to.eql('ROL_INSUFICIENTE'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_ayudante}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Rodolfo\",\n  \"edad\": 5,\n  \"nivelEnergia\": 98\n}"
            },
            "url": "{{base_url}}/api/renos"
          }
        }
      ]
    },
